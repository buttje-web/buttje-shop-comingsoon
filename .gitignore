# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Bild-Arbeitsordner (nicht Teil der App; Produktbilder liegen auf der Shopify-CDN,
# per .vercelignore auch vom Deploy ausgeschlossen). Nur lokale Arbeitsdaten.
/produktbilder-roh
/produktbilder-buehne
/produktbilder-buehne-v2

# Hersteller-PDFs (SDB/Datenblaetter), lokal abgelegt. Einbau in den Shop ist
# ein eigener Auftrag; bis dahin nicht im Repo und nicht im Deployment.
/datenblaetter

# Python-Zwischenstand der Bildskripte
__pycache__/
